{
  "name": "qrcode-avaliacao",
  "version": "1.0.0",
  "description": "Backend do FeedQR",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext js src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:test": "npm --prefix frontend test",
    "frontend:e2e": "npm --prefix frontend run test:e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olucasortiz/qrcode-avaliacao.git"
  },
  "overrides": {
    "@prisma/config": { "deepmerge-ts": "8.0.2" },
    "nodemon": { "chokidar": "4.0.3" }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/olucasortiz/qrcode-avaliacao/issues"
  },
  "homepage": "https://github.com/olucasortiz/qrcode-avaliacao#readme",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "6.19.3",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
