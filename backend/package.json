{
  "name": "qrcode-avaliacao",
  "version": "1.0.0",
  "description": "Backend do FeedQR",
  "main": "src/server.js",
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "nodemon --watch src --ext js src/server.js",
    "start": "node src/server.js",
    "build": "npm run prisma:generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "production:smoke": "node scripts/check-production-start.js",
    "prisma:validate": "prisma validate --schema=prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "mongo:generate": "prisma generate --schema=prisma/schema.mongo.prisma",
    "mongo:sync": "node scripts/sync-mongodb.js",
    "mongo:migrate": "node scripts/migrate-sqlite-to-mongo.js",
    "mongo:rollback": "node scripts/rollback-mongo-to-sqlite.js",
    "mongo:verify-atlas": "node scripts/verify-atlas.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olucasortiz/qrcode-avaliacao.git"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "nodemon": {
      "chokidar": "4.0.3"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/olucasortiz/qrcode-avaliacao/issues"
  },
  "homepage": "https://github.com/olucasortiz/qrcode-avaliacao#readme",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "mongodb": "^7.7.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "prisma": "6.19.3",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
