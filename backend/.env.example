# ==============================================================================
# FeedQR Backend — Configuração de Ambiente (.env)
# ==============================================================================
# IMPORTANTE: Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA comite arquivos .env contendo credenciais ou segredos reais.

# Porta do servidor HTTP
PORT=3000

# Ambiente de execução (development | production | test)
NODE_ENV=development

# Conexão definitiva com o MongoDB Atlas ou réplica local compatível
# Requisitos: MongoDB 6.0+ em modo Replica Set (com suporte a transações multi-documento e TLS)
# Exemplo Atlas: mongodb+srv://<usuario>:<senha>@<cluster-host>/feedqr?retryWrites=true&w=majority&appName=cluster-qrcode
DATABASE_URL="mongodb+srv://<db_user>:<db_password>@<cluster-host>/feedqr?retryWrites=true&w=majority&appName=cluster-qrcode"

# Segredo criptográfico para assinatura e verificação de tokens JWT (HS256)
# Requisito de segurança: Mínimo de 32 caracteres criptograficamente pseudo-aleatórios.
# Para gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="gere_um_segredo_aleatorio_com_pelo_menos_32_caracteres_aqui"

# URL pública do Frontend (utilizada na geração das URLs codificadas nos QR Codes)
# Em desenvolvimento: http://127.0.0.1:5173
# Em produção: https://feedqr.seu-dominio.com (sem barra no final)
FRONTEND_PUBLIC_URL="http://127.0.0.1:5173"

# Origens autorizadas pelo CORS (separadas por vírgula, sem barras no final)
# Em desenvolvimento: http://127.0.0.1:5173,http://localhost:5173
# Em produção: https://feedqr.seu-dominio.com
CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"

# Configuração de Proxy Reverso (Cloudflare, Nginx, Render, Railway, Fly.io, Vercel)
# Defina como "true" ou "1" se a aplicação estiver atrás de um reverse proxy com terminação TLS,
# para que o rate limiter capture o IP real do cliente (via cabeçalho X-Forwarded-For).
TRUST_PROXY=false
