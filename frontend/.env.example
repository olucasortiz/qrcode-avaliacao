# ==============================================================================
# FeedQR Frontend — Configuração de Ambiente (.env)
# ==============================================================================

# URL base das requisições para a API do backend
# Local (com proxy do Vite): /api
# Produção (se hospedado em domínio ou subdomínio separado): https://api.seu-dominio.com/api
VITE_API_BASE_URL=/api

# Alvo do proxy reverso de desenvolvimento local do Vite (usado apenas em npm run dev)
API_PROXY_TARGET=http://127.0.0.1:3000

# URL pública canônica do frontend (opcional em dev, recomendada se testar leitura de QR Code em rede local/mobile)
# Exemplo local mobile: http://192.168.1.100:5173
# Exemplo produção: https://feedqr.seu-dominio.com
VITE_FRONTEND_PUBLIC_URL=http://127.0.0.1:5173
